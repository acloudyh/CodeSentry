{
  "openapi": "3.1.0",
  "info": {
    "title": "CodeSentry HTTP 错误兼容契约",
    "version": "1.2.0",
    "description": "本次先整改 v1 通用错误与追踪协议；旧成功响应不变。本文仅覆盖已评审的通用协议样例，不代表全部业务接口已经满足规范。全量接口清单与剩余差距见 docs/standards/audit.md。"
  },
  "servers": [
    {
      "url": "https://localhost:5173/api"
    }
  ],
  "tags": [
    {
      "name": "platform",
      "description": "平台公共契约"
    }
  ],
  "paths": {
    "/v1/reports/page": {
      "get": {
        "operationId": "listReportPage",
        "summary": "按项目与资产分页查询报告（v1 兼容成功体）",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "businessProjectId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "assetId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "既有 ApiResponse<ReportPage> 成功体"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/v2/report-archives": {
      "post": {
        "operationId": "createReportArchive",
        "summary": "显式冻结资产或项目报告，重复提交复用既有快照",
        "description": "首次创建与重放均返回相同 201 与 Location；幂等键以 SHA-256 存储并保留至少24小时，不保存请求中的凭据。",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArchiveRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "已创建或幂等复用既有档案",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "只读 HTML 资源地址"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "上一页返回的 nextCursor；首页不传。",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "每页条数，默认 20，上限 100；超限返回 400。",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "required": false,
        "description": "排序白名单，格式 field:asc|desc，逗号分隔。",
        "schema": {
          "type": "string"
        },
        "example": "createdAt:desc"
      },
      "OrderId": {
        "name": "orderId",
        "in": "path",
        "required": true,
        "description": "订单 ID",
        "schema": {
          "type": "string"
        },
        "example": "ord_123"
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "客户端生成的唯一键，服务端 24 小时内去重。",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      }
    },
    "headers": {
      "Location": {
        "description": "新创建资源的 URL",
        "schema": {
          "type": "string",
          "format": "uri"
        }
      },
      "RetryAfter": {
        "description": "建议重试等待秒数",
        "schema": {
          "type": "integer"
        }
      },
      "RateLimitLimit": {
        "schema": {
          "type": "integer"
        }
      },
      "RateLimitRemaining": {
        "schema": {
          "type": "integer"
        }
      },
      "RateLimitReset": {
        "schema": {
          "type": "integer"
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "traceId",
          "errors"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            }
          },
          "success": {
            "type": "boolean",
            "const": false,
            "description": "v1 兼容字段"
          },
          "message": {
            "type": "string",
            "description": "v1 兼容字段，与 detail 一致"
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ArchiveRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scanRunId": {
            "type": "integer",
            "minimum": 1
          },
          "businessProjectId": {
            "type": "integer",
            "minimum": 1
          },
          "roundId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "scanRunId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "businessProjectId"
                  ]
                },
                {
                  "required": [
                    "roundId"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "businessProjectId",
              "roundId"
            ],
            "not": {
              "required": [
                "scanRunId"
              ]
            }
          }
        ]
      },
      "ArchiveReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reportUrl"
        ],
        "properties": {
          "reportUrl": {
            "type": "string",
            "description": "只读 HTML 资源地址；已归档内容固定，下载其他格式保持现有入口"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求不合法；errors 返回全部字段错误且不含原始值",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未认证",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "没有权限",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "请求冲突",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "请求过于频繁",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "重试前等待秒数"
          }
        }
      },
      "InternalServerError": {
        "description": "内部错误，仅返回安全文案和 traceId",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unavailable": {
        "description": "服务暂不可用",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "重试前等待秒数"
          }
        }
      }
    }
  }
}
